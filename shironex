#!/usr/bin/env bash
set -Eeuo pipefail

APP_NAME="shironex-panel"
NODE_SERVICE="shironex-node"
APP_DIR="${SHIRONEX_PANEL_DIR:-/opt/snck-panel}"

root(){ [[ "$EUID" -eq 0 ]] || { echo "Use: sudo shironex" >&2; exit 1; }; }

panel(){
  case "${1:-status}" in
    start) pm2 start "$APP_NAME" ;;
    stop) pm2 stop "$APP_NAME" ;;
    restart) pm2 restart "$APP_NAME" --update-env ;;
    status) pm2 status "$APP_NAME" ;;
    logs) pm2 logs "$APP_NAME" --lines 100 ;;
    *) echo "Usage: shironex panel {start|stop|restart|status|logs}"; exit 2 ;;
  esac
}

node(){
  root
  case "${1:-status}" in
    start) systemctl start "$NODE_SERVICE" ;;
    stop) systemctl stop "$NODE_SERVICE" ;;
    restart) systemctl restart "$NODE_SERVICE" ;;
    status) systemctl status "$NODE_SERVICE" --no-pager ;;
    logs) journalctl -u "$NODE_SERVICE" -n 100 --no-pager ;;
    *) echo "Usage: shironex node {start|stop|restart|status|logs}"; exit 2 ;;
  esac
}

menu(){
  root
  while true; do
    clear 2>/dev/null || true
    cat <<'EOF'
╔══════════════════════════════════════════════╗
║            SHIRONEX CONTROL CENTER           ║
╚══════════════════════════════════════════════╝

[1] Start Panel
[2] Stop Panel
[3] Restart Panel
[4] Panel Status
[5] Start Node
[6] Stop Node
[7] Restart Node
[8] Node Status
[9] View Node Logs
[10] Update ShiroNex
[11] Repair ShiroNex
[12] System Information
[13] Backup
[14] Configure HTTPS
[15] Diagnostics
[0] Exit
EOF
    read -r -p $'\nSelect an option: ' choice
    case "$choice" in
      1) panel start ;;
      2) panel stop ;;
      3) panel restart ;;
      4) panel status ;;
      5) node start ;;
      6) node stop ;;
      7) node restart ;;
      8) node status ;;
      9) node logs ;;
      10) bash "$APP_DIR/install.sh" update ;;
      11) bash "$APP_DIR/install.sh" repair ;;
      12) bash "$APP_DIR/install.sh" info ;;
      13) bash "$APP_DIR/install.sh" backup ;;
      14) bash "$APP_DIR/install.sh" ssl ;;
      15) bash "$APP_DIR/install.sh" diagnostics ;;
      0) exit 0 ;;
      *) echo "Invalid option." ;;
    esac
    read -r -p $'\nPress Enter to continue...' _
  done
}

case "${1:-menu}" in
  panel) panel "${2:-status}" ;;
  node) node "${2:-status}" ;;
  update|repair|backup|ssl|diagnostics|uninstall|info)
    root
    bash "$APP_DIR/install.sh" "$1"
    ;;
  menu) menu ;;
  --help|-h)
    cat <<'EOF'
ShiroNex CLI

sudo shironex
sudo shironex panel status
sudo shironex panel restart
sudo shironex node status
sudo shironex node logs
sudo shironex update
sudo shironex repair
sudo shironex backup
sudo shironex ssl
sudo shironex diagnostics
EOF
    ;;
  *) echo "Unknown command. Use: sudo shironex --help"; exit 2 ;;
esac
