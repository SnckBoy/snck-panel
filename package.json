    "dev": "tsx watch server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "createuser": "tsx scripts/createuser.ts",
    "migrate:json": "tsx scripts/migrate-json-to-postgres.ts",
    "test": "tsx scripts/test-themes.mts && tsx scripts/test-discord-rewards.mts",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test:atomic-json": "tsx scripts/test-atomic-json.mts",
    "test:discord-rewards": "tsx scripts/test-discord-rewards.mts"
  },
