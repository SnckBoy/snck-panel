# SNCK PANEL production configuration
NODE_ENV=production
HOST=0.0.0.0
PORT=6767
PANEL_URL=https://panel.example.com
CORS_ORIGIN=https://panel.example.com

# Relational persistence (PostgreSQL-compatible)
DATABASE_URL=postgresql://snck:change-me@127.0.0.1:5432/snck
DB_POOL_SIZE=10

# Authentication and node security
JWT_SECRET=replace-with-at-least-32-random-characters
NODE_AUTH_SECRET=replace-with-a-strong-node-bootstrap-secret
NODE_ENCRYPTION_KEY=replace-with-a-strong-encryption-key
NODE_REQUEST_MAX_SKEW_MS=60000

# Runtime
SFTP_PORT=6868
NODE_REQUEST_TIMEOUT_MS=10000
NODE_HEARTBEAT_TIMEOUT_MS=45000
DOCKER_SOCKET_PATH=/var/run/docker.sock
DEV_AUTO_LOGIN=false

# Storage
SNCK_DATA_DIR=.data
SNCK_SERVER_ROOT=/var/lib/snck/servers
SNCK_BACKUP_ROOT=/var/lib/snck/backups
SNCK_UPLOAD_ROOT=/var/lib/snck/uploads
MAX_UPLOAD_BYTES=5368709120

# Rate limiting
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=5
RATE_LIMIT_COMMAND=60
RATE_LIMIT_UPLOAD=30
RATE_LIMIT_WINDOW_MS=60000

# Optional HTTPS certificate paths
PANEL_TLS_KEY=
PANEL_TLS_CERT=

# Optional integrations
MODRINTH_API_BASE=https://api.modrinth.com/v2
PLAYIT_ENABLED=false
CLOUDFLARE_TUNNEL_ENABLED=false

# Never commit this file with real secrets.
