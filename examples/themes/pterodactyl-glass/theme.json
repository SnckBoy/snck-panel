{
  "id": "pterodactyl-glass",
  "name": "Pterodactyl Glass",
  "version": "1.0.0",
  "author": "Snck",
  "description": "A full Pterodactyl-inspired hosting-panel layout preset for Snck Panel, with a server-first dashboard, reordered server tools, compact hosting navigation, and translucent navy surfaces.",
  "supportedPanelVersion": ">=0.2.0",
  "config": {
    "primary": "#3b82f6",
    "secondary": "#1d4ed8",
    "accent": "#60a5fa",
    "background": "#0b1118",
    "surface": "#172330",
    "sidebar": "#0b141e",
    "navbar": "#14202b",
    "text": "#edf4fb",
    "muted": "#9aabba",
    "border": "#344454",
    "success": "#36c98f",
    "warning": "#f0b64b",
    "error": "#f16d78",
    "radius": 8,
    "fontFamily": "inter",
    "fontScale": 1,
    "density": "comfortable",
    "elevation": "soft",
    "surfaceOpacity": 76
  },
  "layout": {
    "navigationOrder": [
      "overview",
      "servers",
      "nodes",
      "deploy",
      "fleet",
      "admin-control",
      "api-keys",
      "cloudflare",
      "snck-theme",
      "settings"
    ],
    "hiddenNavigation": [],
    "dashboardOrder": [
      "server-inventory",
      "metrics",
      "welcome",
      "quick-actions",
      "system-health"
    ],
    "hiddenDashboard": [
      "welcome",
      "quick-actions",
      "system-health"
    ],
    "metricsOrder": [
      "cpu",
      "ram",
      "net",
      "nodes"
    ],
    "hiddenMetrics": [],
    "structure": {
      "shell": "pterodactyl",
      "navigationMode": "sidebar",
      "sidebarMode": "expanded",
      "contentWidth": "wide",
      "dashboardMode": "server-first",
      "serverNavigationMode": "sidebar",
      "serverNavigationOrder": [
        "console",
        "files",
        "players",
        "properties",
        "plugins",
        "mods",
        "modpacks",
        "backups",
        "sftp",
        "subusers",
        "settings",
        "overview",
        "playit"
      ],
      "hiddenServerNavigation": []
    }
  }
}
